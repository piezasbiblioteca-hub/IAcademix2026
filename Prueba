<style>
  /* === BOTONES INSTITUCIONALES UTADEO === */
  .btn-utadeo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #003366; /* Azul institucional */
    color: #ffffff;
    padding: 10px 18px;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    margin-top: 10px;
    margin-right: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .btn-utadeo:hover {
    background-color: #0056b3; /* Azul más claro */
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-utadeo svg {
    width: 18px;
    height: 18px;
    fill: white;
  }

  .resultado-item {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 25px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  .resultado-item h3 {
    color: #003366;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const categoriaSelect    = document.getElementById("categoria")    || document.getElementById("Categoría");
  const subcategoriaSelect = document.getElementById("subcategoria") || document.getElementById("Subcategoría");
  const resultadosDiv = document.getElementById("resultados");

  let herramientas = [];

  function pick(item, keys) {
    for (const k of keys) {
      if (k in item && item[k] != null) {
        const v = String(item[k]).trim();
        if (v !== "") return v;
      }
    }
    return "";
  }

  fetch("herramientas_ia_tadeo.json")
    .then(r => r.json())
    .then(data => {
      herramientas = data;

      // === CARGAR CATEGORÍAS ===
      const categorias = [...new Set(
        herramientas.map(it => pick(it, ["Categorías Principales"]))
      )].filter(Boolean);

      categorias.forEach(cat => {
        const opt = document.createElement("option");
        opt.value = cat;
        opt.textContent = cat;
        categoriaSelect.appendChild(opt);
      });

      // === CAMBIO DE CATEGORÍA ===
      categoriaSelect.addEventListener("change", () => {
        subcategoriaSelect.innerHTML = '<option value="">-- Selecciona una subcategoría --</option>';
        subcategoriaSelect.disabled = false;
        resultadosDiv.innerHTML = "";

        const catSel = categoriaSelect.value;
        if (!catSel) return;

        const subcats = [...new Set(
          herramientas
            .filter(it => pick(it, ["Categorías Principales"]) === catSel)
            .map(it => pick(it, ["Subcategorías"]))
        )].filter(Boolean);

        subcats.forEach(sub => {
          const opt = document.createElement("option");
          opt.value = opt.textContent = sub;
          subcategoriaSelect.appendChild(opt);
        });
      });

      // === CAMBIO DE SUBCATEGORÍA ===
      subcategoriaSelect.addEventListener("change", () => {
        resultadosDiv.innerHTML = "";
        const catSel  = categoriaSelect.value;
        const subSel  = subcategoriaSelect.value;

        const resultados = herramientas.filter(it =>
          pick(it, ["Categorías Principales"]) === catSel &&
          pick(it, ["Subcategorías"]) === subSel
        );

        if (resultados.length === 0) {
          resultadosDiv.innerHTML = "<p>No se encontraron resultados para esta selección.</p>";
          return;
        }

        resultados.forEach(item => {
          const nombre = pick(item, ["Nombre de la herramienta IA", "Nombre de la herramienta", "Herramienta"]) || "Sin nombre";
          const subcat = pick(item, ["Subcategorías"]) || "No especificada";
          const nivel  = pick(item, ["Nivel de dificultad ", "Nivel de dificultad", "Nivel"]);
          const costo  = pick(item, ["Costo ", "Costo", "Costo (USD)"]);
          const desc   = pick(item, ["Descripción de la herramienta IA", "Descripción", "descripcion"]);
          const fac    = pick(item, ["Facultad a la que aplica", "Facultad"]);
          const link   = pick(item, ["Link de acceso a la herramienta", "URL", "Enlace"]);
          const tuto   = pick(item, ["Tutorial "]);

          const div = document.createElement("div");
          div.classList.add("resultado-item");

          // SVGs inline: uno para "Ir a la aplicación" y otro para "Ver tutorial"
          const svgApp = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M14 3v2h3.59L10 12.59 11.41 14 19 6.41V10h2V3z"/>
              <path d="M5 5h5V3H3v7h2z"/>
            </svg>`;
          
          const svgTuto = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M10 8.64v6.72L15.27 12z"/>
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10
                       10-4.48 10-10S17.52 2 12 2zm0 18
                       c-4.41 0-8-3.59-8-8s3.59-8 8-8
                       8 3.59 8 8-3.59 8-8 8z"/>
            </svg>`;

          div.innerHTML = `
            <h3>${nombre}</h3>
            <p><strong>Subcategoría:</strong> ${subcat}</p>
            <p><strong>Nivel:</strong> ${nivel || "No especificado"} 
               | <strong>Costo:</strong> ${costo || "No indicado"}</p>
            <p><strong>Descripción:</strong> ${desc || "Sin descripción disponible"}</p>
            <p><strong>Facultad:</strong> ${fac || "No definida"}</p>
            ${link ? `<a href="${link}" target="_blank" class="btn-utadeo">${svgApp} Ir a la aplicación</a>` : ""}
            ${tuto ? `<a href="${tuto}" target="_blank" class="btn-utadeo">${svgTuto} Ver tutorial</a>` : ""}
          `;

          resultadosDiv.appendChild(div);
        });
      });
    })
    .catch(err => {
      console.error("Error al cargar el archivo JSON:", err);
      resultadosDiv.innerHTML = "<p>Error al cargar los datos.</p>";
    });
});
